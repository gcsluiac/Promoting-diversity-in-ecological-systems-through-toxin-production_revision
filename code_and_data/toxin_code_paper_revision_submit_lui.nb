              RowBox[{"(", 
               RowBox[{
                RowBox[{"(", "1", ")"}], "*", "n1"}], ")"}]}]}], ")"}], "*", 
           "k22"}]}], "}"}], "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"F", "\[Rule]", " ", "1.03"}], ",", 
          RowBox[{"rm", "\[Rule]", " ", "1.2"}], ",", " ", 
          RowBox[{"k11", "\[Rule]", " ", "0.1"}], ",", 
          RowBox[{"k21", "\[Rule]", " ", "0.2"}], ",", 
          RowBox[{"k31", "\[Rule]", " ", "0.4"}], ",", " ", 
