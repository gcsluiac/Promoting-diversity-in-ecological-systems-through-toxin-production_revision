Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "running", " ", "the", " ", "code", " ", "to", " ", "obtain", " ", "two", 
     " ", "matrices"}], ",", " ", 
    RowBox[{
    "need", " ", "to", " ", "uncomment", " ", "two", " ", "lines", " ", 
     "below", " ", "to", " ", "save", " ", "data"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"single", " ", "toxin", " ", "producer"}], ",", " ", 
    RowBox[{"nut", " ", "sensing"}], ",", " ", 
    RowBox[{
     RowBox[{"original", " ", "trade"}], "-", "offf"}], ",", " ", 
    RowBox[{"fm", "=", "0.9"}], ",", " ", "finer", ",", " ", "IC1"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"finalstoreB", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"fmvary", "=", "0.9"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"aavary", " ", "=", "14"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"F1", " ", "=", " ", "0.03"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"F1", " ", "=", " ", "0.55"}], ";"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"F1", " ", "=", " ", "0.8"}], ";"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"F2", "=", " ", "0"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"load", " ", "=", "0.1"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"RM", "=", "1.2"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"FFF", "=", "1.03"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Sc", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"RM", "/", "FFF"}], "-", "load"}], ")"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Con", " ", "=", " ", "2"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"K11", "=", "0.4"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"K21", "=", "0.6"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Clear", "[", "psvary", "]"}], "\[IndentingNewLine]", 
   RowBox[{"Clear", "[", "ccvary", "]"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"ccvary", "=", "0.01"}], ",", 
      RowBox[{"ccvary", "<", "0.3"}], ",", 
      RowBox[{"ccvary", "=", 
       RowBox[{"ccvary", "+", "0.01"}]}], ","}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Do", "[", " ", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"finalBsub", "=", 
       RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Do", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"s", " ", "=", " ", 
          RowBox[{"NDSolve", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"{", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"x", "'"}], "[", "t", "]"}], "\[Equal]", " ", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"rm", "/", 
                    RowBox[{"(", 
                    RowBox[{"load", "+", 
                    RowBox[{"k11", "/", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"1", "-", 
                    RowBox[{"(", 
                    RowBox[{"fmax", "/", 
                    RowBox[{"(", 
                    RowBox[{"1", "+", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"critn1forx", "/", 
                    RowBox[{"n1", "[", "t", "]"}]}], ")"}], "^", "ps"}]}], 
                    ")"}]}], ")"}]}], ")"}], "*", 
                    RowBox[{"n1", "[", "t", "]"}]}], ")"}]}], " ", "+", " ", 
                    RowBox[{
                    RowBox[{"n2", "[", "t", "]"}], "/", "k12"}]}], ")"}]}], "-",
                     "F"}], ")"}], "*", 
                  RowBox[{"x", "[", "t", "]"}]}]}], ",", "     ", 
                RowBox[{
                 RowBox[{
                  RowBox[{"y", "'"}], "[", "t", "]"}], "\[Equal]", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"rm", "/", 
                    RowBox[{"(", 
                    RowBox[{"load", "+", 
                    RowBox[{"k21", "/", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"(", "1", ")"}], "*", 
                    RowBox[{"n1", "[", "t", "]"}]}], ")"}]}], " ", "+", " ", 
                    RowBox[{
                    RowBox[{"n2", "[", "t", "]"}], "/", "k22"}]}], ")"}]}], "-",
                     "F"}], ")"}], "*", 
                  RowBox[{"y", "[", "t", "]"}]}]}], ",", 
                "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{
                  RowBox[{"n1", "'"}], "[", "t", "]"}], "\[Equal]", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"a1", "-", 
                    RowBox[{"n1", "[", "t", "]"}]}], ")"}], "F"}], "-", 
                  RowBox[{"S11", "  ", 
                   RowBox[{"(", 
                    RowBox[{"rm", "/", 
                    RowBox[{"(", 
                    RowBox[{"load", "+", 
                    RowBox[{"k11", "/", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"1", "-", 
                    RowBox[{"(", 
                    RowBox[{"fmax", "/", 
                    RowBox[{"(", 
                    RowBox[{"1", "+", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"critn1forx", "/", 
                    RowBox[{"n1", "[", "t", "]"}]}], ")"}], "^", "ps"}]}], 
                    ")"}]}], ")"}]}], ")"}], "*", 
                    RowBox[{"n1", "[", "t", "]"}]}], ")"}]}], " ", "+", " ", 
                    RowBox[{
                    RowBox[{"n2", "[", "t", "]"}], "/", "k12"}]}], ")"}]}], 
                    ")"}], "*", 
                   RowBox[{"x", "[", "t", "]"}]}], "\[IndentingNewLine]", "-",
                   " ", 
                  RowBox[{"S12", " ", 
                   RowBox[{"(", 
                    RowBox[{"rm", "/", 
                    RowBox[{"(", 
                    RowBox[{"load", "+", 
                    RowBox[{"k21", "/", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"(", "1", ")"}], "*", 
                    RowBox[{"n1", "[", "t", "]"}]}], ")"}]}], " ", "+", " ", 
                    RowBox[{
