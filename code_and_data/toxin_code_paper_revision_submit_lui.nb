                    RowBox[{"(", "1", ")"}], "*", 
                    RowBox[{"n1", "[", "t", "]"}]}], ")"}]}]}], " ", ")"}]}], 
               ")"}], "*", 
              RowBox[{"x", "[", "t", "]"}]}], "\[IndentingNewLine]", "-", 
             RowBox[{
              RowBox[{"(", " ", 
               RowBox[{"rm2", "/", 
                RowBox[{"(", 
                 RowBox[{"1", "+", 
                  RowBox[{"k", "/", 
                   RowBox[{"(", 
