            RowBox[{"n1", "[", "0", "]"}], "\[Equal]", "50"}], ",", " ", 
           RowBox[{
            RowBox[{"n2", "[", "0", "]"}], "\[Equal]", "a2"}]}], "}"}], "/.", 
         
         RowBox[{"{", 
          RowBox[{
           RowBox[{"F", "\[Rule]", " ", "FFF"}], ",", 
           RowBox[{"D1", "\[Rule]", 
            RowBox[{
