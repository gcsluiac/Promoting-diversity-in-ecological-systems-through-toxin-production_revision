   RowBox[{
   "green", " ", "from", " ", "coexist", " ", "to", " ", "dominates"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"FFF", " ", "=", " ", "0.1"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"CCC", " ", "=", " ", "0.1"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"kkkk", " ", "=", " ", "0.2"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"bbb", " ", "=", " ", "0.5"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"RM1", " ", "=", " ", "0.28"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"RM3", " ", "=", "0.22"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"s2", " ", "=", " ", 
     RowBox[{"NDSolve", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"x", "'"}], "[", "t", "]"}], "\[Equal]", " ", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"rm1", "/", 
                 RowBox[{"(", 
                  RowBox[{"1", "+", 
                   RowBox[{"k", "/", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"(", "1", ")"}], "*", 
                    RowBox[{"n1", "[", "t", "]"}]}], ")"}]}]}], " ", ")"}]}], 
                "*", 
                RowBox[{"(", 
                 RowBox[{"1", "-", 
                  RowBox[{"(", 
                   RowBox[{"fmax", "/", 
                    RowBox[{"(", 
                    RowBox[{"1", "+", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"critn1forx", "/", 
                    RowBox[{"n1", "[", "t", "]"}]}], ")"}], "^", "ps"}]}], 
                    ")"}]}], ")"}]}], ")"}]}], "-", 
               RowBox[{"D1", "*", 
                RowBox[{"n2", "[", "t", "]"}]}], "-", "F"}], ")"}], "*", 
             RowBox[{"x", "[", "t", "]"}]}]}], ",", "     ", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{"y", "'"}], "[", "t", "]"}], "\[Equal]", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"rm2", "/", 
                RowBox[{"(", 
                 RowBox[{"1", "+", 
                  RowBox[{"k", "/", 
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{"(", "1", ")"}], "*", 
                    RowBox[{"n1", "[", "t", "]"}]}], ")"}]}]}], " ", ")"}]}], 
               "-", 
               RowBox[{"D2", "*", 
                RowBox[{"n2", "[", "t", "]"}]}], "-", "F"}], ")"}], "*", 
             RowBox[{"y", "[", "t", "]"}]}]}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{"z", "'"}], "[", "t", "]"}], "\[Equal]", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"rm3", "/", 
                RowBox[{"(", 
                 RowBox[{"1", "+", 
                  RowBox[{"k", "/", 
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{"(", "1", ")"}], "*", 
                    RowBox[{"n1", "[", "t", "]"}]}], ")"}]}]}], " ", ")"}]}], 
               "-", 
               RowBox[{"D3", "*", 
                RowBox[{"n2", "[", "t", "]"}]}], "-", "F"}], ")"}], "*", 
